/*
  nf-core/chipseq run config for CIAI cluster — SLURM executor, parallel
  Recommended replacement for member{1..5}/dbsuper_pipeline/nfcore_chipseq.config

  Key changes vs the previous version:
    - executor: 'local' → 'slurm'   (Nextflow submits each task as its own sbatch)
    - maxForks=1 / queueSize=1 REMOVED (parallelism killers)
    - blanket cpus/memory defaults REMOVED; replaced with withLabel: overrides
      that match nf-core/chipseq's own process_* labels
    - added params.max_cpus / max_memory / max_time safety caps
    - driver no longer needs a 24-CPU / 64-GB allocation;
      each child SLURM job carries its own resource request
*/

process {
  executor = 'slurm'

  // Cluster-specific
  queue = 'cscc-cpu-p'
  clusterOptions = '--qos=cscc-cpu-qos'

  // Default wall-time ceiling per task (individual labels override)
  time = '72h'

  // Retry transient failures — only on signals that look transient
  errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
  maxRetries    = 2
  maxErrors     = '-1'

  // nf-core/chipseq built-in labels — sized for a 24-CPU / 256-GB node class.
  // Adjust process_high_memory downward if your partition's biggest node has <200 GB.
  withLabel:process_single      { cpus = 1;  memory = 6.GB;   time = 4.h  }
  withLabel:process_low         { cpus = 2;  memory = 12.GB;  time = 4.h  }
  withLabel:process_medium      { cpus = 6;  memory = 36.GB;  time = 8.h  }
  withLabel:process_high        { cpus = 12; memory = 72.GB;  time = 16.h }
  withLabel:process_high_memory { cpus = 4;  memory = 200.GB; time = 16.h }
  withLabel:process_long        { time = 20.h }
}

executor {
  name            = 'slurm'
  queueSize       = 50        // max concurrent SLURM child jobs Nextflow will submit
  submitRateLimit = '10 sec'  // throttle sbatch calls to the scheduler
  pollInterval    = '30 sec'
}

// Put work on scratch (fast) and keep it separate from the project folder
workDir = "/scratch/${System.getenv('USER')}/nf_work/nfcore_chipseq"

// Nextflow reporting (overwrite avoids "file already exists" errors)
trace    { enabled = true; file = "logs/nfcore_trace.txt";     overwrite = true }
report   { enabled = true; file = "logs/nfcore_report.html";   overwrite = true }
timeline { enabled = true; file = "logs/nfcore_timeline.html"; overwrite = true }
dag      { enabled = true; file = "logs/nfcore_dag.png";        overwrite = true }

// Containers
singularity {
  enabled     = true
  autoMounts  = true
  cacheDir    = "/scratch/${System.getenv('USER')}/singularity_cache"
  pullTimeout = '12h'

  // Uncomment ONLY if the loop-device error returns after going parallel:
  // runOptions = '--no-mount tmp --cleanenv'
}

// Keep Nextflow + Singularity caches on scratch (not NFS $HOME)
env.NXF_HOME             = "/scratch/${System.getenv('USER')}/.nextflow"
env.TMPDIR               = "${workDir}/tmp"
env.TMP                  = "${workDir}/tmp"
env.TEMP                 = "${workDir}/tmp"
env.SINGULARITY_CACHEDIR = "/scratch/${System.getenv('USER')}/singularity_cache"
env.SINGULARITY_TMPDIR   = "${workDir}/singularity_tmp"

params {
  // Local iGenomes cache (avoid S3 pulls)
  igenomes_base = "${launchDir}/ref/igenomes"

  // Numeric literal — MACS2 effective human genome size
  macs_gsize = 2700000000

  // Cluster safety caps — any mis-labelled task is clamped to these
  max_cpus   = 24
  max_memory = '200.GB'
  max_time   = '72.h'
}
