/*
  nf-core/chipseq run config for Karakoram HPC — SLURM executor, parallel
  Runs the full samplesheet in a single Nextflow driver (not split member-wise).

  Key changes vs the previous version:
    - executor: 'local' → 'slurm'   (Nextflow submits each task as its own sbatch)
    - maxForks=1 / queueSize=1 REMOVED (parallelism killers)
    - blanket cpus/memory defaults REMOVED; replaced with withLabel: overrides
      that match nf-core/chipseq's own process_* labels
    - added params.max_cpus / max_memory / max_time safety caps
    - driver no longer needs a 24-CPU / 64-GB allocation;
      each child SLURM job carries its own resource request
*/

process {
  executor = 'slurm'

  // Cluster-specific
  queue = 'cpu'

  // Default wall-time ceiling per task (individual labels override)
  time = '168h'

  // Retry transient failures — only on signals that look transient
  errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
  maxRetries    = 2
  maxErrors     = '-1'

  // Each child SLURM job can land on any node; /scratch is node-local and
  // may not have $TMPDIR present. Create it before the singularity exec.
  // MULTIQC (via Kaleido/Chromium) fails without this.
  beforeScript = 'mkdir -p "$TMPDIR" "$SINGULARITY_TMPDIR" 2>/dev/null || true'

  // Sized for Karakoram cpu node (AMD EPYC 9654: 384 cores, 1.5 TiB RAM).
  // process_high at 32 CPU / 128 GB → up to 12 concurrent (384 CPU / 1536 GB).
  // process_high_memory at 512 GB → 3 concurrent; MarkDuplicates is RAM-bound.
  withLabel:process_single      { cpus = 2;  memory = 12.GB;  time = 4.h  }
  withLabel:process_low         { cpus = 4;  memory = 24.GB;  time = 4.h  }
  withLabel:process_medium      { cpus = 16; memory = 72.GB;  time = 8.h  }
  withLabel:process_high        { cpus = 32; memory = 128.GB; time = 16.h }
  withLabel:process_high_memory { cpus = 16; memory = 512.GB; time = 16.h }
  withLabel:process_long        { time = 24.h }

}

executor {
  name            = 'slurm'
  queueSize       = 50        // Karakoram: no per-user QOS cap; 384-core node sustains many concurrent tasks.
  submitRateLimit = '1 sec'   // throttle sbatch calls to the scheduler
  pollInterval    = '5 sec'  // how often Nextflow polls SLURM for job state
}

// workDir MUST be on a shared filesystem (visible to all compute nodes).
// Resolves to /storage/projects/akshat.mistry/dbsuper/nf_work/nfcore_chipseq
// (one level above dbsuper_pipeline/), keeping the project clone clean.
workDir = "${launchDir}/../nf_work/nfcore_chipseq"

// Nextflow reporting — organised under logs/reports/
trace    { enabled = true; file = "logs/reports/nfcore_trace.txt";     overwrite = true }
report   { enabled = true; file = "logs/reports/nfcore_report.html";   overwrite = true }
timeline { enabled = true; file = "logs/reports/nfcore_timeline.html"; overwrite = true }
dag      { enabled = true; file = "logs/reports/nfcore_dag.png";        overwrite = true }

// Containers — cacheDir on shared storage so all nodes see the .sif files
singularity {
  enabled     = true
  autoMounts  = true
  cacheDir    = "/storage/home/${System.getenv('USER')}/.singularity_cache"
  pullTimeout = '12h'

  // Bind /scratch so the node-local $TMPDIR path is visible inside the
  // container (autoMounts binds only $HOME, $PWD, /tmp by default).
  // MULTIQC's Kaleido/Chromium opens shared memory at $TMPDIR.
  runOptions = '--bind /scratch'
}

// NXF_HOME + singularity cache on shared storage; per-task tmp on node-local /scratch
env.NXF_HOME             = "/storage/home/${System.getenv('USER')}/.nextflow"
env.TMPDIR               = "/scratch/${System.getenv('USER')}/tmp"
env.TMP                  = "/scratch/${System.getenv('USER')}/tmp"
env.TEMP                 = "/scratch/${System.getenv('USER')}/tmp"
env.SINGULARITY_CACHEDIR = "/storage/home/${System.getenv('USER')}/.singularity_cache"
env.SINGULARITY_TMPDIR   = "/scratch/${System.getenv('USER')}/singularity_tmp"

params {
  // Shared local iGenomes cache (avoid S3 pulls)
  // TODO: update path once GRCh38 reference is staged under /storage/datasets/
  igenomes_base = "/storage/datasets/igenomes"

  // Numeric literal — MACS2 effective human genome size
  macs_gsize = 2700000000

  // Cluster safety caps for Karakoram cpu node (AMD EPYC 9654: 384 cores,
  // 1.5 TiB RAM; cpu partition wall-time ceiling 7 days).
  max_cpus   = 96
  max_memory = '1400.GB'
  max_time   = '168.h'
}
