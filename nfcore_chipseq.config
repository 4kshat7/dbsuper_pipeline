/*
  nf-core/chipseq run config for Karakoram HPC — SLURM executor, parallel
  Runs the full samplesheet in a single Nextflow driver (not split member-wise).

  Key changes vs the previous version:
    - executor: 'local' → 'slurm'   (Nextflow submits each task as its own sbatch)
    - maxForks=1 / queueSize=1 REMOVED (parallelism killers)
    - blanket cpus/memory defaults REMOVED; replaced with withLabel: overrides
      that match nf-core/chipseq's own process_* labels
    - added params.max_cpus / max_memory / max_time safety caps
    - driver no longer needs a 24-CPU / 64-GB allocation;
      each child SLURM job carries its own resource request
*/

process {
  executor = 'slurm'

  // Cluster-specific
  queue = 'cpu'

  // Default wall-time ceiling per task (individual labels override)
  time = '168h'

  // Retry transient failures — only on signals that look transient
  errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
  maxRetries    = 2
  maxErrors     = '-1'

  // Each child SLURM job can land on any node; /scratch is node-local and
  // may not have $TMPDIR present. Create it before the apptainer exec.
  // MULTIQC (via Kaleido/Chromium) fails without this.
  beforeScript = 'mkdir -p "$TMPDIR" "$APPTAINER_TMPDIR" 2>/dev/null || true'

  // Sized for Karakoram cpu node (AMD EPYC 9654: 384 cores, 1.5 TiB RAM).
  //
  // Right-sized 2026-09-28 from measured usage (trace p99 peak_rss / p90 %cpu of
  // our human GEO run +  full ENCODE run). The old blanket sizes
  // (e.g. TrimGalore 32c/128GB using ≤7c/6GB) left the node "full" with ~118 of
  // 384 cores busy and blocked on reserved memory ≥35% of the time.
  //
  // RESUME-SAFE: Nextflow does not hash cpus/memory/time (only the unrendered
  // script, inputs, container and task.ext.*), so none of this re-runs cached
  // tasks. SLURM here does not enforce --mem (no cgroups); memory only matters
  // for scheduling and for tools that size a heap from task.memory (Picard,
  // FastQC — sized generously below).
  withLabel:process_single      { cpus = 2;  memory = 12.GB;  time = 4.h  }
  withLabel:process_low         { cpus = 2;  memory = 8.GB;   time = 4.h  }
  withLabel:process_medium      { cpus = 4;  memory = 32.GB;  time = 8.h  }
  withLabel:process_high        { cpus = 32; memory = 128.GB; time = 16.h }
  withLabel:process_high_memory { cpus = 16; memory = 512.GB; time = 16.h }
  withLabel:process_long        { time = 24.h }

  // Per-process sizes (measured use → request). TRIMGALORE, BWA_MEM and FASTQC
  // are sized inside their error-handling blocks further down (one block per name).
  //   SAMTOOLS_SORT ~1.7 cores / ≤14 GB.
  withName: '.*:SAMTOOLS_SORT'             { cpus = 8;  memory = 24.GB }
  //   small samtools QC steps: ~1 core, <1 GB.
  withName: '.*:SAMTOOLS_(INDEX|STATS|FLAGSTAT|IDXSTATS)' { cpus = 2; memory = 4.GB }
  //   Picard: -Xmx = 0.8 × task.memory, so keep headroom; on a failure retry once
  //   with double memory (a Java OOM exits 1, which the global rule would 'finish').
  withName: '.*:PICARD_(MARKDUPLICATES|MERGESAMFILES)' {
    cpus = 4; memory = { 48.GB * task.attempt }
    errorStrategy = { task.attempt == 1 ? 'retry' : 'finish' }
    maxRetries = 1
  }
  //   MACS3 single-threaded, ≤5.4 GB.  HOMER ~1 core, ≤3.8 GB.
  withName: '.*:MACS3_CALLPEAK'            { cpus = 2;  memory = 16.GB }
  withName: '.*:HOMER_ANNOTATEPEAKS'       { cpus = 2;  memory = 16.GB }
  //   BAMTOOLS_FILTER ~1.5 cores; GENOMECOV ≤20 GB; BAM_REMOVE_ORPHANS ≤14 GB.
  withName: '.*:(BAMTOOLS_FILTER|BEDTOOLS_GENOMECOV|BAM_REMOVE_ORPHANS)' { cpus = 4; memory = 32.GB }
  //   deepTools: computeMatrix uses ~12 cores / 9 GB, plotFingerprint ~10 cores / 7 GB.
  withName: '.*:DEEPTOOLS_COMPUTEMATRIX'   { cpus = 16; memory = 16.GB }
  withName: '.*:DEEPTOOLS_PLOTFINGERPRINT' { cpus = 12; memory = 16.GB }
  //   One-off whole-cohort steps (6k samples): keep the old generous size.
  withName: '.*:(SUBREAD_FEATURECOUNTS|DESEQ2_QC|MACS3_CONSENSUS|MULTIQC)' { cpus = 16; memory = 72.GB }

  // PRESEQ is optional library-complexity QC and can fail for edge-case
  // libraries. Retry each failed PRESEQ task once, then ignore only that
  // PRESEQ failure so alignment, peak calling, and other samples continue.
  withName: 'NFCORE_CHIPSEQ:CHIPSEQ:PRESEQ_LCEXTRAP' {
    errorStrategy = { task.attempt == 1 ? 'retry' : 'ignore' }
    maxRetries = 1
  }

  // BWA_MEM exits 1 on a malformed FASTQ pair — most commonly mate read names
  // out of sync ("[mem_sam_pe] paired reads have different names"), which is a
  // data defect in the SRA download, not a pipeline bug. The global strategy
  // above maps exit 1 -> 'finish', so ONE bad GEO sample tears the whole run
  // down: that is exactly what killed the 6,031-sample human run on 2026-08-03
  // (GSM5172187 / SRR13963663) after 21h of completed FastQC + TrimGalore.
  // Retry only the transient signals, then drop the offending sample and let
  // the other ~6,030 continue. Ignored samples produce no BAM and fall out of
  // the run; collect them afterwards from logs/reports/nfcore_trace.txt.
  //
  // Size: keep 32 cpus — `-t` sets bwa's paired-end batch size (10 Mbp × threads)
  // when -K is unset, so changing it would make new PE BAMs differ from the ~4k
  // already aligned. Memory 128 → 64 GB (RSS p99 47 GB, max 92 GB; not enforced).
  withName: '.*:BWA_MEM' {
    cpus = 32; memory = 64.GB
    errorStrategy = { task.exitStatus in [143,137,104,134,139,140] && task.attempt <= 2 ? 'retry' : 'ignore' }
    maxRetries    = 2
  }

  // TRIMGALORE exits 255 on a paired FASTQ whose mates disagree in length
  // ("Read 2 output is truncated at sequence count: N, please check your
  // paired-end input files! Terminating..."). Same class of defect as the
  // BWA_MEM case above — a bad SRA download, not a pipeline fault — and it
  // hits EARLIER, before alignment. Observed 2026-09-20: GSM6160223 killed the
  // run at task 804 of ~13,300 after ~3h56m. Same treatment: retry only the
  // transient signals, then drop the sample and keep going.
  //
  // Size: uses ≤7 cores / 6 GB. The module caps --cores at 8 and 12 cpus still
  // yields --cores 8 (cpus-3 SE / cpus-4 PE), so trimming output is unchanged.
  withName: '.*:TRIMGALORE' {
    cpus = 12; memory = 16.GB
    errorStrategy = { task.exitStatus in [143,137,104,134,139,140] && task.attempt <= 2 ? 'retry' : 'ignore' }
    maxRetries    = 2
  }

  // FASTQC is QC-only and feeds MultiQC; never let a malformed FASTQ abort the
  // run on its account. Size: ~1 core per FASTQ; its --memory is task.memory/cpus.
  withName: '.*:FASTQC' {
    cpus = 4; memory = 24.GB
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
    maxRetries    = 2
  }

  // GPU lane of the hybrid pipeline (pipelines/chipseq-2.1.0-hybrid.patch; only
  // exists when running the deployed hybrid pipeline with --bwa_route). Matches
  // nothing when running stock nf-core/chipseq.
  //
  // Runs with the LOCAL executor, i.e. inside the Nextflow driver job, which must
  // itself hold the GPU:  sbatch -p gpu --gres=gpu:1 -c 20 --mem=144G submit_driver.sh ...
  // (submit_driver.sh refuses a GPU route without it). Per-task SLURM jobs waited
  // 4–12 min each for free cores on this busy node, which erased the GPU's gain.
  // maxForks 1: one GPU, and Parabricks pre-allocates ~38 of its 48 GB.
  // --nv only here: SLURM does not fence the GPU (no cgroups), so no other task
  // may see it.
  // Sizes from the 2026-09-28 pilot: 16 threads were as fast as 32; host RSS
  // reached ~99 GB for paired-end with -K (26–37 GB without).
  withName: '.*:FASTQ_ALIGN_BWA:PARABRICKS_FQ2BAM' {
    executor         = 'local'
    maxForks         = 1
    cpus             = 16
    memory           = 128.GB
    time             = 2.h
    containerOptions = '--nv'
    // A bad FASTQ is retried then dropped (like BWA_MEM), but maxErrors is a
    // circuit breaker: a systematic GPU failure (driver, --nv, reference) stops
    // the run after 25 failures instead of silently dropping every GPU sample.
    errorStrategy    = { task.attempt <= 2 ? 'retry' : 'ignore' }
    maxRetries       = 2
    maxErrors        = 25
  }

}

executor {
  name            = 'slurm'
  // Max SLURM jobs this run keeps submitted at once (running + pending).
  // 120 filled the node but left ~80 jobs pending in squeue; kept at 30 so the
  // run leaves room for other users. Resume-safe to change (not part of the
  // task hash). Raise it (e.g. 60–120) if the node sits idle in the downstream
  // phase, where most tasks are small (2–4 cpus).
  queueSize       = 30        // Karakoram: no per-user QOS cap
  // ~125k downstream tasks: at 1 job/s, submission alone would take ≥35 h.
  submitRateLimit = '5/1s'    // max 5 sbatch calls per second
  pollInterval    = '5 sec'  // how often Nextflow polls SLURM for job state
}

// workDir MUST be on a shared filesystem (visible to all compute nodes).
// Resolves one level above dbsuper_pipeline/, keeping the project clone clean;
// for this GEO clone that is /storage/projects/akshat.mistry/geo_data/nf_work/.
//
// NOTE: this MUST stay `nfcore_chipseq` (not the `_t2t` suffix carried over from
// the T2T clone). The human run's completed FastQC + TrimGalore tasks live in
// nf_work/nfcore_chipseq/; pointing at a different workDir silently invalidates
// `-resume` and re-runs ~4,600 FastQC + all TrimGalore jobs from scratch.
workDir = "${launchDir}/../nf_work/nfcore_chipseq"

// Nextflow reporting — organised under logs/reports/
trace    { enabled = true; file = "logs/reports/nfcore_trace.txt";     overwrite = true }
report   { enabled = true; file = "logs/reports/nfcore_report.html";   overwrite = true }
timeline { enabled = true; file = "logs/reports/nfcore_timeline.html"; overwrite = true }
dag      { enabled = true; file = "logs/reports/nfcore_dag.png";        overwrite = true }

// Containers — apptainer is the runtime on Karakoram (drop-in singularity
// replacement). cacheDir on shared storage so all nodes see the .sif files.
// We launch with `-profile apptainer` so nf-core's own profile already sets
// apptainer.enabled = true and autoMounts = true; we just add cluster paths.
//
// Path note: cacheDir keeps the historical `.singularity_cache` name so the
// 6.9 GB of already-pulled SIFs are reused — apptainer doesn't care about
// the directory name, only the env var pointing at it.
apptainer {
  cacheDir    = "/storage/home/${System.getenv('USER')}/.singularity_cache"
  pullTimeout = '12h'

  // Bind /scratch so the node-local $TMPDIR path is visible inside the
  // container (autoMounts binds only $HOME, $PWD, /tmp by default).
  // MULTIQC's Kaleido/Chromium opens shared memory at $TMPDIR.
  runOptions = '--bind /scratch'
}

// NXF_HOME + apptainer cache on shared storage; per-task tmp on node-local /scratch
env.NXF_HOME            = "/storage/home/${System.getenv('USER')}/.nextflow"
env.TMPDIR              = "/scratch/${System.getenv('USER')}/tmp"
env.TMP                 = "/scratch/${System.getenv('USER')}/tmp"
env.TEMP                = "/scratch/${System.getenv('USER')}/tmp"
env.APPTAINER_CACHEDIR  = "/storage/home/${System.getenv('USER')}/.singularity_cache"
env.APPTAINER_TMPDIR    = "/scratch/${System.getenv('USER')}/apptainer_tmp"

params {
  // Shared local iGenomes cache (avoid S3 pulls). nf-core's igenomes.config
  // resolves the per-genome paths under this base, e.g.
  //   Mus_musculus/UCSC/mm10  and  Homo_sapiens/NCBI/GRCh38
  // NOTE: the local mm10 BWA index is FLATTENED (no version0.6.0/ subdir that
  // igenomes.config expects), so mouse runs must also pass --bwa-index to
  // submit_driver.sh. The human GRCh38 copy has version0.6.0/ and needs no override.
  //
  // DO NOT rely on igenomes_base here: setting it in a `-c` config DOES NOTHING.
  // nf-core's nextflow.config does `includeConfig 'conf/igenomes.config'`, which
  // interpolates "${params.igenomes_base}/..." into params.genomes AT INCLUDE
  // TIME, while igenomes_base still holds its default s3://ngi-igenomes/igenomes/.
  // A `-c` config is merged afterwards, so it changes igenomes_base itself but
  // NOT the already-baked genome paths. Verified with `-preview` 2026-09-20:
  //   igenomes_base : /storage/datasets/igenomes        <- set
  //   fasta         : s3://ngi-igenomes/igenomes//...   <- still S3
  // The local copy is used ONLY by passing the paths explicitly, which
  // submit_driver.sh does via --fasta / --gtf / --bwa-index.
  //igenomes_base = "/storage/datasets/igenomes"

  // macs_gsize is intentionally not set here. submit_driver.sh requires an
  // explicit --macs-gsize N for every invocation.

  // Cluster safety caps for Karakoram cpu node (AMD EPYC 9654: 384 cores,
  // 1.5 TiB RAM; cpu partition wall-time ceiling 7 days).
  max_cpus   = 96
  max_memory = '1400.GB'
  max_time   = '168.h'

  // Hybrid pipeline GPU lane only (ignored, with a harmless "unrecognised
  // parameter" warning, by stock nf-core/chipseq). Chosen from the 2026-09-28
  // pilot against existing CPU BAMs:
  //  - paired-end: '-K 320000000' fixes bwa's batch size at what our CPU runs
  //    use (10 Mbp x 32 threads, see BWA_MEM above) -> 100% identical records;
  //    without it ~0.01% of pairs differ (insert-size estimate per batch).
  //  - '--fix-mate' writes the MC/MQ mate tags that CPU bwa writes (Picard QC).
  // These are part of the GPU tasks' fingerprint: keep them fixed for a session.
  pb_bwa_pe_opts = '-K 320000000'
  pb_args        = '--fix-mate'
}
