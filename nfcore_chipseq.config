/*
  nf-core/chipseq run config for CIAI cluster usage
  Running Nextflow INSIDE an allocated Slurm node -> executor=local is correct.

  Key fix: Singularity "no loop devices available" -> reduce concurrency (maxForks + queueSize)
*/

process {
  executor = 'local'

  // Defaults per-process; nf-core will override for some tools
  cpus   = 20
  memory = '64 GB'
  time   = '72h'

  // Retry transient failures
  errorStrategy = 'retry'
  maxRetries    = 3
  maxErrors     = '-1'

  // CRITICAL: prevent exhausting /dev/loop* by starting too many containers at once
  maxForks = 1
}

executor {
  // CRITICAL: don't queue/launch many tasks concurrently
  queueSize = 1
}

// Put work on scratch (fast) and keep it separate from the project folder
workDir = "/scratch/${System.getenv('USER')}/nf_work/nfcore_chipseq"

// Nextflow reporting (overwrite avoids “file already exists” errors)
trace {
  enabled   = true
  file      = "logs/nfcore_trace.txt"
  overwrite = true
}
report {
  enabled   = true
  file      = "logs/nfcore_report.html"
  overwrite = true
}
timeline {
  enabled   = true
  file      = "logs/nfcore_timeline.html"
  overwrite = true
}
dag {
  enabled   = true
  file      = "logs/nfcore_dag.png"
  overwrite = true
}

/*
  Containers: nf-core strongly prefers this on HPC
*/
singularity {
  enabled = true
  autoMounts = true
  cacheDir = "/scratch/${System.getenv('USER')}/singularity_cache"
  pullTimeout = '12h'
}

/*
  Keep Nextflow cache local (helps performance / avoids HOME churn)
*/
env.NXF_HOME = "/scratch/${System.getenv('USER')}/.nextflow"

//using temp dirs under workDir so they exist & are writable
env.TMPDIR = "${workDir}/tmp"
env.TMP    = "${workDir}/tmp"
env.TEMP   = "${workDir}/tmp"

// Also tell Singularity to use scratch for tmp/cache
env.SINGULARITY_CACHEDIR = "/scratch/${System.getenv('USER')}/singularity_cache"
env.SINGULARITY_TMPDIR   = "${workDir}/singularity_tmp"

/*
  IMPORTANT: Tell nf-core to use your LOCAL iGenomes cache instead of S3.
  Create:  /scratch/$USER/work/dbsuper_nf/ref/igenomes
*/
params {
  igenomes_base = "${launchDir}/ref/igenomes"

  // Use a numeric literal (NOT quoted, NOT scientific-notation string)
  macs_gsize = 2700000000
}
