/*
  khan-lab/enhancerflow run config for Karakoram HPC.

  Pass via:  nextflow run khan-lab/enhancerflow -r main \
               -profile apptainer -c Enhancerflow/nextflow.slurm.config ...

  This file is a thin override on top of the upstream nextflow.config +
  the `apptainer` profile. It does NOT re-declare process executors per
  process name — instead it uses the standard nf-core process_* labels
  (process_single/low/medium/high/high_memory/long) which every Enhancerflow
  module already carries. See conf/base.config in the upstream repo.

  Mirrors the design choices in nfcore_chipseq.config:
    - executor 'slurm' (Nextflow submits each task as its own sbatch)
    - workDir on shared storage so all compute nodes see it
    - apptainer cacheDir on shared storage; per-task tmp on node-local /scratch
    - withLabel resource ladder sized for the EPYC 9654 cpu node
*/

process {
  executor = 'slurm'

  // Cluster-specific
  queue = 'cpu'

  // Default wall-time ceiling; per-label values override
  time = '168h'

  // Retry transient failures only on signals that look transient.
  // Upstream base.config retries on 130..145 + 104 + 175 — we narrow to the
  // OOM/SIGTERM family so genuine bugs fail fast.
  errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
  maxRetries    = 2
  maxErrors     = '-1'

  // Each child SLURM job can land on any node; /scratch is node-local.
  // Create $TMPDIR before apptainer exec — some tools (Kaleido/Chromium in
  // MultiQC, deepTools cache) fail without it.
  beforeScript = 'mkdir -p "$TMPDIR" "$APPTAINER_TMPDIR" 2>/dev/null || true'

  // Sized for Karakoram cpu node (AMD EPYC 9654: 384 cores, 1.5 TiB RAM).
  // ROSE2 / FIMO / HOMER annotatePeaks / SEA / rGREAT / Intervene → process_medium
  // COLTRON, deepTools computematrix/multibigwigsummary/plotfingerprint → process_high
  withLabel:process_single      { cpus = 2;  memory = 12.GB;  time = 4.h  }
  withLabel:process_low         { cpus = 4;  memory = 24.GB;  time = 4.h  }
  withLabel:process_medium      { cpus = 16; memory = 72.GB;  time = 8.h  }
  withLabel:process_high        { cpus = 32; memory = 128.GB; time = 16.h }
  withLabel:process_high_memory { cpus = 16; memory = 512.GB; time = 16.h }
  withLabel:process_long        { time = 24.h }


  // ROSE2 spawns 4 internal `rose2-bamToGFF` subprocesses doing random-access
  // BAM reads on shared /storage. Running many ROSE2 tasks concurrently
  // collapses storage throughput and the subprocesses stall (observed: 3
  // simultaneous ROSE2 tasks hung for 8h producing no output, then completed
  // in ~45 min each when re-tried serially). Cap concurrency and right-size
  // the slot to match what ROSE2 actually uses.
  withName: 'ROSE2' {
    cpus       = 8
    memory     = 48.GB
    time       = { 6.h * task.attempt }
    maxForks   = 4
    maxRetries = 1
    errorStrategy = { task.exitStatus in [140,143,137] && task.attempt <= 1 ? 'retry' : 'ignore' }
  }

  // HOMER_FINDMOTIFSGENOME's module ternary picks `docker.io/asntech/homer:v5.1`
  // under `-profile apptainer` (containerEngine == 'apptainer', not
  // 'singularity'), but that image's manifest has no linux/amd64 child so the
  // apptainer pull fails with "no child with platform linux/amd64 in index".
  // The module's environment.yml actually pins homer=4.11; the seqera community
  // SIF URL below is the pre-built linux/amd64 HOMER 4.11 image referenced in
  // the same module declaration. Force apptainer to use that instead.
  withName: 'HOMER_FINDMOTIFSGENOME_SE|HOMER_FINDMOTIFSGENOME_TE' {
    container = 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/0f/0fe4a3875b78dce3c66b43fb96489769cc32e55e329e2525d2af09096af2252a/data'
  }

  // FIMO scales with total bp × #motifs (~700 JASPAR motifs). One outlier sample
  // (ENCSR597ULV: 66k enhancers × ~2 kb avg = 131 MB fasta) blew past the
  // process_medium 8 h ceiling on all 3 retries with exit 140 (SLURM TIMEOUT).
  // Scale time/memory by task.attempt so retries actually grow the budget:
  // attempt 1 → 24 h / 32 GB, attempt 2 → 48 h / 64 GB, attempt 3 → 72 h / 96 GB.
  withName: 'FIMO_SE|FIMO_TE' {
    cpus   = 16
    time   = { 24.h  * task.attempt }
    memory = { 32.GB * task.attempt }
  }

  // Hard ceiling per task — replaces the old params.max_* mechanism (which
  // Enhancerflow's schema doesn't declare and complains about).
  // cpu partition wall-time = 7 days; node has 384 cores / 1.5 TiB.
  resourceLimits = [ cpus: 96, memory: 1400.GB, time: 168.h ]
}

executor {
  name            = 'slurm'
  queueSize       = 50         // Karakoram has no per-user QOS cap
  submitRateLimit = '1 sec'    // throttle sbatch calls to the scheduler
  pollInterval    = '5 sec'    // SLURM job-state poll interval
}

// workDir MUST be on a shared filesystem (visible to all compute nodes).
// Resolves to /storage/projects/akshat.mistry/dbsuper/nf_work/enhancerflow
// (one level above dbsuper_pipeline/), keeping the project clone clean and
// matching the layout used by nfcore_chipseq.config.
workDir = "${launchDir}/../../nf_work/enhancerflow_t2t"

// Nextflow reporting — organised under logs/reports/
trace    { enabled = true; file = "logs/reports/enhancerflow_trace.txt";     overwrite = true }
report   { enabled = true; file = "logs/reports/enhancerflow_report.html";   overwrite = true }
timeline { enabled = true; file = "logs/reports/enhancerflow_timeline.html"; overwrite = true }
dag      { enabled = true; file = "logs/reports/enhancerflow_dag.png";       overwrite = true }

// Containers — apptainer is the runtime on Karakoram. cacheDir on shared
// storage so all nodes see the .sif files. The `apptainer` profile (passed
// via -profile apptainer) already sets apptainer.enabled = true and
// autoMounts = true; we just add cluster paths.
//
// cacheDir keeps the historical `.singularity_cache` name so already-pulled
// SIFs are reused — apptainer doesn't care about the directory name.
apptainer {
  cacheDir    = "/storage/shared/.singularity_cache"
  pullTimeout = '12h'

  // Bind both shared roots into the container. autoMounts (set by the
  // apptainer profile) is supposed to bind $HOME, but apptainer on
  // Karakoram doesn't honour it reliably — Enhancerflow's local modules
  // call scripts via the host-absolute ${moduleDir}/bin/... path
  // (ROSE_TO_BEDS, EXTRACT_CONSTITUENTS, ROSE2 ...), which lives under
  // /storage/home/$USER/.nextflow/assets/. /scratch is needed for $TMPDIR.
  runOptions = '--bind /scratch --bind /storage'
}

// NXF_HOME + apptainer cache on shared storage; per-task tmp on node-local /scratch
env.NXF_HOME            = "/storage/home/${System.getenv('USER')}/.nextflow"
env.TMPDIR              = "/scratch/${System.getenv('USER')}/tmp"
env.TMP                 = "/scratch/${System.getenv('USER')}/tmp"
env.TEMP                 = "/scratch/${System.getenv('USER')}/tmp"
env.APPTAINER_CACHEDIR  = "/storage/shared/.singularity_cache"
env.APPTAINER_TMPDIR    = "/scratch/${System.getenv('USER')}/apptainer_tmp"

// TODO: when the GRCh38 reference is staged at /storage/datasets/igenomes,
// add  `params { igenomes_base = "/storage/datasets/igenomes" }`  here so all
// nodes pull from local disk instead of S3. Keep aligned with nfcore_chipseq.config.
