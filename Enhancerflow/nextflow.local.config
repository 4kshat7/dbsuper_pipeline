/*
  khan-lab/enhancerflow run config for LOCAL execution (no SLURM).

  Pass via:  nextflow run khan-lab/enhancerflow -r main \
               -profile apptainer -c Enhancerflow/nextflow.local.config ...

  Use this when:
    - you've grabbed an interactive allocation (salloc) and want everything
      to run inside that single allocation, or
    - you're driving the run from a dev box with no scheduler.

  For production at scale on Karakoram, prefer Enhancerflow/nextflow.config
  (SLURM executor) — it parallelises across the full cluster.

  Mirrors the chipseq-side per-task labels but at smaller per-task sizes,
  since everything has to fit on a single host.
*/

process {
  executor = 'local'

  // Default ceilings; per-label values below override
  time = '72h'

  // Retry transient failures only on signals that look transient
  errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
  maxRetries    = 2
  maxErrors     = '-1'

  // Make sure $TMPDIR exists before each task hands off to apptainer.
  beforeScript = 'mkdir -p "$TMPDIR" "$APPTAINER_TMPDIR" 2>/dev/null || true'

  // Single-host resource ladder. Sized to leave headroom for the OS and
  // any other interactive work; bump these if you have a dedicated node.
  // process_medium covers ROSE2, FIMO, HOMER, SEA, rGREAT, Intervene.
  // process_high covers COLTRON + the heavier deepTools tasks.
  withLabel:process_single      { cpus = 1;  memory = 6.GB;   time = 4.h  }
  withLabel:process_low         { cpus = 2;  memory = 12.GB;  time = 4.h  }
  withLabel:process_medium      { cpus = 8;  memory = 32.GB;  time = 8.h  }
  withLabel:process_high        { cpus = 16; memory = 64.GB;  time = 16.h }
  withLabel:process_high_memory { cpus = 8;  memory = 128.GB; time = 16.h }
  withLabel:process_long        { time = 24.h }

  // Cap concurrent containers — keeps /dev/loop* and FD usage sane on a
  // shared box and prevents starving the deepTools/COLTRON tasks of RAM.
  maxForks = 4

  // Hard ceiling per task — replaces the old params.max_* mechanism (which
  // Enhancerflow's schema doesn't declare). Sized for a single-host run.
  resourceLimits = [ cpus: 32, memory: 256.GB, time: 72.h ]
}

executor {
  name      = 'local'
  queueSize = 8
}

// workDir on node-local scratch — no need for a shared FS in local mode,
// and /scratch is much faster than /storage for Nextflow's file-staging.
workDir = "/scratch/${System.getenv('USER')}/work/enhancerflow"

// Nextflow reporting — organised under logs/reports/ alongside the SLURM run.
trace    { enabled = true; file = "logs/reports/enhancerflow_local_trace.txt";     overwrite = true }
report   { enabled = true; file = "logs/reports/enhancerflow_local_report.html";   overwrite = true }
timeline { enabled = true; file = "logs/reports/enhancerflow_local_timeline.html"; overwrite = true }
dag      { enabled = true; file = "logs/reports/enhancerflow_local_dag.png";       overwrite = true }

// Containers — apptainer (singularity drop-in replacement on Karakoram).
// Same cacheDir as the SLURM run, so the .sif files don't get pulled twice.
// The `apptainer` profile sets enabled/autoMounts; we just add cluster paths.
// cacheDir keeps the historical `.singularity_cache` name so already-pulled
// SIFs are reused.
apptainer {
  cacheDir    = "/storage/home/${System.getenv('USER')}/.singularity_cache"
  pullTimeout = '12h'
  // Bind both shared roots — see nextflow.slurm.config for the rationale.
  // Enhancerflow's local modules (ROSE_TO_BEDS, EXTRACT_CONSTITUENTS, ROSE2)
  // call scripts via the host-absolute ${moduleDir}/bin/... path, so the
  // container needs /storage and /scratch visible.
  runOptions  = '--bind /scratch --bind /storage'
}

env.NXF_HOME            = "/storage/home/${System.getenv('USER')}/.nextflow"
env.TMPDIR              = "/scratch/${System.getenv('USER')}/tmp"
env.TMP                 = "/scratch/${System.getenv('USER')}/tmp"
env.TEMP                = "/scratch/${System.getenv('USER')}/tmp"
env.APPTAINER_CACHEDIR  = "/storage/home/${System.getenv('USER')}/.singularity_cache"
env.APPTAINER_TMPDIR    = "/scratch/${System.getenv('USER')}/apptainer_tmp"

// TODO: when the GRCh38 reference is staged at /storage/datasets/igenomes,
// add  `params { igenomes_base = "/storage/datasets/igenomes" }`  here.
