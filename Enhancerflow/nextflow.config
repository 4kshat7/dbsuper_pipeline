

process {
  executor = 'local'

  // Copy input files into the work dir.
  // Hard-links ('link') can cause permission issues inside podman containers
  // (touch .command.trace: permission denied). 'copy' avoids this.
  stageInMode = 'copy'

  // Defaults per-process - allow multiple tasks to run in parallel
  cpus   = 20
  memory = '64 GB'
  time   = '72h'

  // Retry transient failures
  errorStrategy = 'retry'
  maxRetries    = 3
  maxErrors     = '-1'

  // Allow up to 4 containers at once (safe /dev/loop* limit)
  maxForks = 4

  // Override ROSE2 specifically to use available CPUs
  withName: 'NFCORE_ENHANCERFLOW:ENHANCERFLOW:SUPERENHANCER_CALLING:ROSE2' {
    cpus = 20
    memory = '64 GB'
  }
}

executor {
  queueSize = 8
}

// Put work on scratch (fast)
workDir = "/scratch/${System.getenv('USER')}/work/dbsuper_nf_new/Enhancerflow/work"

// Nextflow reporting
trace {
  enabled   = true
  file      = "logs/enhancerflow_trace.txt"
  overwrite = true
}
report {
  enabled   = true
  file      = "logs/enhancerflow_report.html"
  overwrite = true
}
timeline {
  enabled   = true
  file      = "logs/enhancerflow_timeline.html"
  overwrite = true
}
dag {
  enabled   = true
  file      = "logs/enhancerflow_dag.png"
  overwrite = true
}

/*
  Singularity configuration
  Singularity runs as the real host UID by default - no user namespace issues,
  no subuid/subgid requirements. Replaces Podman which had .command.trace
  permission errors due to missing /etc/subuid entries.
*/
podman.enabled   = false

singularity {
  enabled    = true
  autoMounts = true   // automatically bind-mount workDir and input paths
  runOptions = "-B /scratch/${System.getenv('USER')}/.nextflow:/scratch/${System.getenv('USER')}/.nextflow"
  cacheDir   = "/scratch/${System.getenv('USER')}/singularity_cache"
}

/*
  Keep Nextflow cache local
*/
env.NXF_HOME = "/scratch/${System.getenv('USER')}/.nextflow"

// Using temp dirs under workDir so they exist & are writable
env.TMPDIR = "${workDir}/tmp"
env.TMP    = "${workDir}/tmp"
env.TEMP   = "${workDir}/tmp"

// Use local iGenomes cache instead of S3
params {
  igenomes_base = "/scratch/${System.getenv('USER')}/work/dbsuper_nf_new/ref/igenomes"
  blacklist = "/scratch/${System.getenv('USER')}/work/dbsuper_nf_new/ref/blacklists/hg38-blacklist.v3.bed"
}

// Note: NXF_HOME is a Nextflow launcher setting, so it must be exported in the shell
// before running nextflow. The env.NXF_HOME line above only sets it for processes.

