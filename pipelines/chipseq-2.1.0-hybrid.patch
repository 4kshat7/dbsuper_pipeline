     //
+    def route = [:]
+    if (params.bwa_route) {
+        file(params.bwa_route, checkIfExists: true).eachLine { line ->
+            def fields = line.trim().tokenize('\t')
+            if (!fields || fields[0].startsWith('#')) return
+            if (fields.size() < 2 || !(fields[1] in ['cpu', 'gpu'])) {
+                error("Invalid line in --bwa_route ${params.bwa_route}: '${line}' (expected: <sample>_REP<n><TAB>cpu|gpu)")
+            }
+            route[fields[0]] = fields[1]
+        }
+    }
+    if (route.containsValue('gpu') && !params.parabricks_ref) {
+        error("--bwa_route sends samples to the GPU lane but --parabricks_ref is not set")
+    }
+
+    ch_reads
+        .branch { meta, reads ->
+            gpu: route[meta.id - ~/_T\d+$/] == 'gpu'
+            cpu: true
+        }
+        .set { ch_lane }
 
-    BWA_MEM ( ch_reads, ch_index, ch_fasta, val_sort_bam )
+    //
+    // Map reads with BWA (CPU lane)
+    //
+    BWA_MEM ( ch_lane.cpu, ch_index, ch_fasta, val_sort_bam )
     ch_versions = ch_versions.mix(BWA_MEM.out.versions.first())
 
+    //
+    // Map reads with Parabricks fq2bam (GPU lane)
+    //
+    ch_pb_ref = params.parabricks_ref
