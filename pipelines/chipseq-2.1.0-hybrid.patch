diff --git a/modules/local/parabricks_fq2bam.nf b/modules/local/parabricks_fq2bam.nf
new file mode 100644
index 0000000..d019b08
--- /dev/null
+++ b/modules/local/parabricks_fq2bam.nf
@@ -0,0 +1,84 @@
+//
+// NVIDIA Parabricks fq2bam as a drop-in for BWA_MEM (dbSUPER hybrid patch).
+// Adapted from nf-core/modules parabricks/fq2bam (Parabricks 4.7.1-1).
+//
+// Same contract as BWA_MEM in this pipeline:
+//  - one <meta.id>.Lb.bam per FASTQ run, fed to the same BAM_SORT_STATS_SAMTOOLS
+//  - read group from meta.read_group (as bwa -R), '-M', secondary alignments
+//    removed (--filter-flag 256 == samtools view -F 0x0100), no duplicate
+//    marking (Picard MarkDuplicates runs after library merging, as for bwa);
+//    those flags live in ext.args (conf/modules.config)
+//
+// Reference: a prepared directory with a REAL genome.fa, its .fai and
+// genome.fa.{amb,ann,bwt,pac,sa} beside it. pbrun resolves --ref to its real
+// path and looks for the index next to that file, so a symlinked FASTA whose
+// index lives elsewhere fails (exit 255). Build it with
+// dbsuper_pipeline/tools/make_parabricks_ref.sh.
+//
+// GPU wiring (executor, --nv, maxForks, resources) belongs in the run config.
+//
+process PARABRICKS_FQ2BAM {
+    tag "$meta.id"
+    label 'process_high'
+    label 'process_gpu'
+
+    container "nvcr.io/nvidia/clara/clara-parabricks:4.7.1-1"
+
+    input:
+    tuple val(meta) , path(reads)
+    tuple val(meta2), path(pb_ref)
+
+    output:
+    tuple val(meta), path("*.bam"), emit: bam
+    path  "versions.yml"          , emit: versions
+
+    when:
+    task.ext.when == null || task.ext.when
+
+    script:
+    if (workflow.profile.tokenize(',').intersect(['conda', 'mamba']).size() >= 1) {
+        error("Parabricks module does not support Conda. Please use Docker / Singularity / Apptainer instead.")
+    }
+    def args   = task.ext.args ?: ''
+    def prefix = task.ext.prefix ?: "${meta.id}.Lb"
+    def in_fq  = meta.single_end ? "--in-se-fq ${reads} ${meta.read_group ?: ''}" : "--in-fq ${reads} ${meta.read_group ?: ''}"
+    // Parabricks defaults to half of the node's RAM for sorting; there are no
+    // cgroups here, so cap it below the task's memory request.
+    def mem_gb = task.memory ? Math.max(8, (task.memory.toGiga() * 0.66) as int) : 32
+    """
+    REF=\$(readlink -f ${pb_ref})/genome.fa
+    for f in "\$REF" "\$REF.fai" "\$REF.amb" "\$REF.ann" "\$REF.bwt" "\$REF.pac" "\$REF.sa"; do
+        [ -s "\$f" ] || { echo "Parabricks reference incomplete, missing: \$f" >&2; exit 2; }
+    done
+
+    PBTMP=\$(mktemp -d -p "\${TMPDIR:-/tmp}" pbtmp.XXXXXX)
+    trap 'rm -rf "\$PBTMP"' EXIT
+
+    pbrun \\
+        fq2bam \\
+        --ref "\$REF" \\
+        ${in_fq} \\
+        --out-bam ${prefix}.bam \\
+        --num-gpus 1 \\
+        --bwa-cpu-thread-pool ${task.cpus} \\
+        --memory-limit ${mem_gb} \\
+        --tmp-dir "\$PBTMP" \\
+        ${args}
+
+    cat <<-END_VERSIONS > versions.yml
+    "${task.process}":
+        parabricks: \$(pbrun version 2>&1 | grep -m1 '^pbrun:' | sed 's/^pbrun:[[:space:]]*//')
+    END_VERSIONS
+    """
+
+    stub:
+    def prefix = task.ext.prefix ?: "${meta.id}.Lb"
+    """
+    touch ${prefix}.bam
+
+    cat <<-END_VERSIONS > versions.yml
+    "${task.process}":
+        parabricks: 4.7.1-1
+    END_VERSIONS
+    """
+}
