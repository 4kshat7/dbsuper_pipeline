 //
 // Alignment with BWA
 //
+// dbSUPER hybrid patch: optional GPU lane. When params.bwa_route is set, every
+// sample-replicate (meta.id without its _T<n> run suffix) marked 'gpu' in that
+// TSV is aligned with NVIDIA Parabricks fq2bam instead of BWA_MEM; all other
+// reads, and all reads when bwa_route is unset, go through the unchanged
+// BWA_MEM call below (same name/script/inputs, so -resume keeps its cache).
+// Both lanes feed the same BAM_SORT_STATS_SAMTOOLS, so file names, QC, publish
+// paths and every downstream step are identical.
+//
 
 include { BWA_MEM                 } from '../../../modules/nf-core/bwa/mem/main'
+include { PARABRICKS_FQ2BAM       } from '../../../modules/local/parabricks_fq2bam'
 include { BAM_SORT_STATS_SAMTOOLS } from '../bam_sort_stats_samtools/main'
 
